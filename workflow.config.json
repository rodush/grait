{
  "schemaVersion": 2,
  "engine": "codex",
  "authentication": "app",
  "supportedEngines": ["codex", "claude", "copilot"],
  "statuses": {
    "backlog": "Backlog",
    "ready": "Ready",
    "inProgress": "In Progress",
    "review": "Review",
    "done": "Done"
  },
  "maxReady": 5,
  "maxInProgress": 5,
  "maxReviewRounds": 10,
  "maxRepeatedBlockingReviews": 3,
  "controllerRepository": "rodush/grait",
  "humanOperators": ["rodush"],
  "allowedWritePaths": [
    "src/**",
    "tests/**",
    "assets/**",
    "docs/project/**",
    "README.md",
    "scripts/setup.mjs",
    "scripts/bootstrap.mjs",
    "scripts/activate.mjs",
    "scripts/lib/setup-apps.mjs",
    "scripts/lib/setup-state.mjs",
    "scripts/lib/local-auth.mjs",
    "scripts/lib/local-context.mjs",
    "scripts/lib/ledger.mjs",
    "scripts/lib/orchestrator.mjs",
    "scripts/lib/policy.mjs",
    "dist/cli.mjs",
    "docs/setup.md",
    "docs/installation.md",
    "scripts/orchestrator.mjs",
    "scripts/lib/bootstrap.mjs",
    "scripts/lib/harness-runtime.mjs",
    "scripts/lib/project.mjs",
    "scripts/lib/tdd.mjs",
    "scripts/lib/verification.mjs",
    "docs/workflow.md",
    "docs/operations.md",
    "docs/tdd.md",
    "automation/skills/grait-orchestrator/SKILL.md",
    ".agents/skills/grait-orchestrator/SKILL.md",
    ".claude/skills/grait-orchestrator/SKILL.md",
    ".github/skills/grait-orchestrator/SKILL.md"
  ],
  "protectedPaths": [
    ".github/workflows/",
    ".github/CODEOWNERS",
    ".codex/",
    "automation/policy/",
    "config/",
    "docs/coding-guidelines.md",
    "docs/review-guidelines.md",
    "docs/architecture.md",
    "docs/decisions.md",
    "docs/agents.md",
    "SECURITY.md",
    "AGENTS.md",
    "CLAUDE.md",
    "workflow.config.json",
    "package.json",
    "package-lock.json",
    ".npmrc",
    "docs/worktrees.md"
  ],
  "labels": {
    "automated": "agent:managed",
    "paused": "agent:paused",
    "needsHuman": "agent:needs-human",
    "admitted": "agent:admitted"
  },
  "tdd": {
    "implementationPaths": [
      "src/**",
      "tests/**",
      "assets/**",
      "docs/project/**",
      "README.md",
      "scripts/setup.mjs",
      "scripts/bootstrap.mjs",
      "scripts/activate.mjs",
      "scripts/lib/setup-apps.mjs",
      "scripts/lib/setup-state.mjs",
      "scripts/lib/local-auth.mjs",
      "scripts/lib/local-context.mjs",
      "scripts/lib/ledger.mjs",
      "scripts/lib/orchestrator.mjs",
      "scripts/lib/policy.mjs",
      "dist/cli.mjs",
      "docs/setup.md",
      "docs/installation.md",
      "scripts/orchestrator.mjs",
      "scripts/lib/bootstrap.mjs",
      "scripts/lib/harness-runtime.mjs",
      "scripts/lib/project.mjs",
      "scripts/lib/tdd.mjs",
      "scripts/lib/verification.mjs",
      "docs/workflow.md",
      "docs/operations.md",
      "docs/tdd.md",
      "automation/skills/grait-orchestrator/SKILL.md",
      ".agents/skills/grait-orchestrator/SKILL.md",
      ".claude/skills/grait-orchestrator/SKILL.md",
      ".github/skills/grait-orchestrator/SKILL.md"
    ],
    "profiles": {
      "tester": {
        "model": null,
        "reasoning": null
      },
      "implementer": {
        "model": null,
        "reasoning": null
      }
    },
    "testPatterns": ["tests/**", "**/test_*.py", "**/*.spec.py", "**/*.test.*"],
    "runner": {
      "install": ["npm", "ci", "--ignore-scripts", "--no-audit", "--no-fund"],
      "command": ["node", "{nodeAdapter}", "tests/*.test.mjs"]
    }
  },
  "execution": "local",
  "maxConcurrentWorkers": 5,
  "orchestrator": {
    "reasoning": "medium"
  }
}

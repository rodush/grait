{
  "schemaVersion": 2,
  "engine": "codex",
  "authentication": "app",
  "supportedEngines": ["codex", "claude", "copilot"],
  "statuses": {
    "backlog": "Backlog",
    "ready": "Ready",
    "inProgress": "In Progress",
    "review": "Review",
    "done": "Done"
  },
  "maxInProgress": 5,
  "maxReviewRounds": 10,
  "maxRepeatedBlockingReviews": 3,
  "controllerRepository": null,
  "humanOperators": [],
  "allowedWritePaths": ["src/**", "tests/**", "assets/**", "docs/project/**"],
  "protectedPaths": [
    ".github/",
    ".agents/",
    ".codex/",
    ".claude/",
    "scripts/",
    "automation/",
    "config/",
    "docs/coding-guidelines.md",
    "docs/workflow.md",
    "docs/review-guidelines.md",
    "docs/setup.md",
    "docs/operations.md",
    "docs/architecture.md",
    "docs/decisions.md",
    "docs/agents.md",
    "SECURITY.md",
    "AGENTS.md",
    "CLAUDE.md",
    "workflow.config.json",
    "package.json",
    "package-lock.json",
    ".npmrc",
    "docs/worktrees.md",
    "docs/tdd.md",
    "docs/installation.md"
  ],
  "labels": {
    "automated": "agent:managed",
    "paused": "agent:paused",
    "needsHuman": "agent:needs-human",
    "admitted": "agent:admitted"
  },
  "tdd": {
    "implementationPaths": ["src/**", "tests/**", "assets/**", "docs/project/**"],
    "profiles": {
      "tester": {
        "model": null,
        "reasoning": null
      },
      "implementer": {
        "model": null,
        "reasoning": null
      }
    },
    "testPatterns": ["tests/**", "**/test_*.py", "**/*.spec.py", "**/*.test.*"],
    "runner": {
      "install": ["npm", "ci", "--ignore-scripts", "--no-audit", "--no-fund"],
      "command": ["node", "{nodeAdapter}", "tests/*.test.mjs"]
    }
  },
  "execution": "local",
  "maxConcurrentWorkers": 2,
  "orchestrator": {
    "reasoning": "medium"
  }
}
